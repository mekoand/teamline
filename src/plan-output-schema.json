{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "message", "questions", "goal", "acceptance", "materials", "resourcePlan", "stages"],
  "properties": {
    "outcome": { "enum": ["plan", "clarification"] },
    "message": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "reason", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "target": { "enum": ["goal", "acceptance", "materials", "resources", "plan"] }
        }
      }
    },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance": { "type": ["string", "null"] },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["repository", "folder", "file", "image", "link", "text"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resourcePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "pace", "runWhenQuotaAvailable"],
      "properties": {
        "priority": { "enum": ["high", "normal", "background"] },
        "pace": { "enum": ["fast", "balanced", "saving"] },
        "runWhenQuotaAvailable": { "type": "boolean" }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "scope", "verification", "verificationCommand", "dependsOn", "executionMethod"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "verificationCommand": { "type": ["string", "null"] },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "executionMethod": { "enum": ["codex", "external"] }
        }
      }
    }
  }
}

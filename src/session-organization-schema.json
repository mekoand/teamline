{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "summary": { "type": "string" },
    "currentState": { "type": "string" },
    "completedHighlights": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "nextAction": { "type": "string" },
    "historicalStages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "outcome": { "type": "string" },
          "summary": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["completed", "in_progress", "unknown"]
          },
          "sourceSessionIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "outcome", "summary", "status", "sourceSessionIds"]
      }
    },
    "futureStages": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "outcome": { "type": "string" },
          "summary": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["unknown", "in_progress"]
          },
          "sourceSessionIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "explicit": { "const": true }
        },
        "required": ["id", "outcome", "summary", "status", "sourceSessionIds", "explicit"]
      }
    },
    "currentProgressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "enumerablePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      },
      "required": ["completed", "total"]
    },
    "inferredRelations": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["id", "from", "to", "label"]
      }
    },
    "toolCalls": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "logs": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["repository", "folder", "file", "image", "link"]
          },
          "label": { "type": "string" },
          "location": { "type": "string" }
        },
        "required": ["id", "type", "label", "location"]
      }
    }
  },
  "required": ["description", "summary", "currentState", "completedHighlights", "nextAction", "historicalStages", "artifacts"]
}
